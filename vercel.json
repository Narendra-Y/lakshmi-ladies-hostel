{
  "buildCommand": "pnpm --filter @workspace/hostel-app run build",
  "outputDirectory": "artifacts/hostel-app/dist/public",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://lakshmi-hostel-api.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
